# Copy to .env and fill in only what you use. Never commit .env.

# API models (run_eval_openai_batch.py / run_eval_vllm_offline.py with an API backend)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional OpenRouter settings
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# Hugging Face token, needed to download gated models (e.g. meta-llama/Meta-Llama-3.1-8B-Instruct)
HF_TOKEN=
